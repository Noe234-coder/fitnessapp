# Response headers for Cloudflare Workers static assets (copied to dist/).
#
# Cloudflare's default for every asset is
#   Cache-Control: public, max-age=0, must-revalidate
# which is what index.html, sw.js and manifest.webmanifest need: a deploy is
# picked up on the next request. Only the hashed build output is overridden.

# Vite puts a content hash in every file name under /assets/, so a given URL
# never changes: cache it for a year without revalidating.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
