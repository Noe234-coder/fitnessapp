# Copy to supabase/functions/.env (gitignored) for the local stack.
# Where the app is served. invite-athlete builds the invite link from it and
# allows this origin, and only this one, to call it from a browser.
APP_BASE_URL=http://localhost:5173

# No key goes in this file. The runtime, local and hosted, gives every
# function SUPABASE_URL and SUPABASE_SECRET_KEYS (a JSON object; invite-athlete
# uses the key named `default`).
